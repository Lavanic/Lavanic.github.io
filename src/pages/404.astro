---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Oliver Ohrt" description="Page not found.">
  <div class="layout">
    <div class="box notfound">
      <img class="notfound-art" src="/images/404.webp" alt="" />
      <div class="notfound-text">
        <h1>error 404</h1>
        <p>the page you're looking for doesn't exist lol.</p>
        <a href="/">&larr; take me home</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    margin: 12vh auto 0;
    width: 560px;
    min-height: 400px;
    display: flex;
    color: #fff;
    /* Same fill as the main page panels */
    background: linear-gradient(
      to bottom,
      rgba(101, 146, 190, 0.95) 0%,
      rgba(84, 130, 174, 0.95) 100%
    );
  }

  .notfound-art {
    width: 50%;
    align-self: stretch;
    object-fit: cover;
    display: block;
  }

  .notfound-text {
    width: 50%;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  .notfound-text h1 {
    font-size: 30px;
    letter-spacing: 2px;
  }

  .notfound-text p {
    font-size: 15px;
    line-height: 1.5;
  }

  .notfound-text a {
    color: #fff;
    font-weight: bold;
  }

  @media (max-width: 1020px) {
    .notfound {
      width: 100%;
      margin-top: 6vh;
      min-height: calc(400px / var(--scale));
    }

    .notfound-text {
      padding: calc(28px / var(--scale)) calc(24px / var(--scale));
      gap: calc(14px / var(--scale));
    }

    .notfound-text h1 {
      font-size: calc(26px / var(--scale));
      letter-spacing: calc(2px / var(--scale));
    }

    .notfound-text p {
      font-size: calc(14px / var(--scale));
    }

    .notfound-text a {
      font-size: calc(14px / var(--scale));
    }
  }
</style>
