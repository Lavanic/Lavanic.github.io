  ---
  import SiteShell from '../layouts/SiteShell.astro';

  export function getStaticPaths() {
    return ['Webmaster', 'Guestbook', 'Links'].map((name) => ({
      params: { page: name.toLowerCase() },
      props: { name },
    }));
  }

  const { name } = Astro.props;
  ---

  <SiteShell>
    <h2>{name}</h2>
    <p class="construction">This page is under construction... come back later!</p>
    <img class="construction-banner" src="/images/construction_banner.gif" width="468" height="28" alt="" />
    <img class="construction-dig" src="/stickers/construction.gif" width="40" height="40" alt="" />
  </SiteShell>

  <style>
    .construction {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .construction::before,
    .construction::after {
      content: "";
      flex: none;
      width: 40px;
      height: 40px;
      background: url("/stickers/construction.gif") center / contain no-repeat;
      image-rendering: pixelated;
    }

    .construction-banner {
      display: block;
      width: calc(100% - 40px);
      height: auto;
      margin: 14px 20px 0;
    }

    .construction-dig {
      display: none;
    }

    @media (max-width: 1020px) {
      .construction::before,
      .construction::after {
        content: none;
      }

      .construction-dig {
        display: block;
        width: calc(120px / var(--scale));
        height: auto;
        margin: calc(12px / var(--scale)) auto 0;
        image-rendering: pixelated;
      }
    }
  </style>
