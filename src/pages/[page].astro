  ---
  import SiteShell from '../layouts/SiteShell.astro';

  export function getStaticPaths() {
    return ['Webmaster', 'Guestbook', 'Links'].map((name) => ({
      params: { page: name.toLowerCase() },
      props: { name },
    }));
  }

  const { name } = Astro.props;
  ---

  <SiteShell>
    <h2>{name}</h2>
    <p class="construction">This page is under construction... come back later!</p>
    <img class="construction-dog" src="/images/construction_dalmatian.gif" width="220" height="170" alt="" />
    <img class="construction-banner" src="/images/construction_banner.gif" width="468" height="28" alt="" />
  </SiteShell>

  <style>
    .construction {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .construction::before,
    .construction::after {
      content: "";
      flex: none;
      width: 40px;
      height: 40px;
      background: url("/stickers/construction.gif") center / contain no-repeat;
      image-rendering: pixelated;
    }

    .construction-banner {
      display: block;
      width: calc(100% - 40px);
      height: auto;
      margin: 14px 20px 0;
      opacity: 0.8;
    }

    .construction-dog {
      display: none;
    }

    @media (max-width: 1020px) {
      .construction::before,
      .construction::after {
        content: none;
      }

      .construction-banner {
        width: 100%;
        margin: calc(12px / var(--scale)) 0 0;
        opacity:0.8;
      }

      .construction-dog {
        display: block;
        width: 100%;
        height: auto;
        margin-top: calc(12px / var(--scale));
        opacity: 0.9;
      }
    }
  </style>
