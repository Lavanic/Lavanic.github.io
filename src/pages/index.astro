---
import { readdir } from 'node:fs/promises';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';

// Auto-discovers every stamp in public/stamps/ at build time.
// Plain readdir instead of import.meta.glob: globbing public/ makes Vite
// emit a second hashed copy of every stamp into dist/_astro/ that nothing uses.
const stampDir = path.join(process.cwd(), 'public/stamps');
const stampFiles = (await readdir(stampDir))
  .filter(f => /\.(png|gif|jpe?g|webp|avif)$/i.test(f))
  .sort();
const stamps = stampFiles.map(f => `/stamps/${f}`);

// The seamless loop works by animating translateX(-50%) across a set rendered twice.
// That only works if one set is wider than the visible bar (~1300px).
// So we pad the array up to at least 30 entries before doubling it.
const MIN_STAMPS = 30;
const copies = stamps.length ? Math.ceil(MIN_STAMPS / stamps.length) : 0;
const paddedStamps = Array(copies).fill(stamps).flat();
---

<BaseLayout title="Oliver Ohrt">
  <div class="layout">
    <div class="box header">
      <h1 class="logo-wrap">
        <img class="logo-fallback" src="/images/logo_fallback.png" width="823" height="287" alt="Oliver Ohrt" />
        <div class="logo-composite">
          <img src="/images/gears.webp" width="169" height="287" alt=""
            onload="var w=this.closest('.logo-wrap');w.querySelector('.logo-fallback').style.display='none';w.querySelector('.logo-composite').style.opacity='1'" />
          <img src="/images/static.png" width="654" height="287" alt="" />
        </div>
      </h1>
    </div>

    <div class="box subheader">
      <div class="welcome-scroll">
        <span>Welcome to my site!</span>
      </div>
    </div>
    <div class="box subheader stamps">
      <div class="marquee" role="img" aria-label="Stamp collection">
        <div class="marquee__inner">
          {paddedStamps.map(src => <img src={src} alt="" fetchpriority="low" decoding="async" />)}
        </div>
        <div class="marquee__inner" aria-hidden="true">
          {paddedStamps.map(src => <img src={src} alt="" fetchpriority="low" decoding="async" />)}
        </div>
      </div>
      <noscript>
        <style is:inline>
          /* The is-ready class never arrives without JS, so force the marquee visible */
          .marquee .marquee__inner {
            opacity: 1 !important;
            animation-play-state: running !important;
          }
          @media (prefers-reduced-motion: reduce) {
            .marquee .marquee__inner {
              animation-play-state: paused !important;
            }
          }
        </style>
      </noscript>
      <script>
        const marquee = document.querySelector('.marquee') as HTMLElement | null;
        const inners = marquee ? Array.from(marquee.querySelectorAll<HTMLElement>('.marquee__inner')) : [];
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        if (marquee && inners.length) {
          // The CSS animation runs on the compositor thread, so the browser's
          // main thread keeps a stale idea of which stamps are on screen and
          // pauses their gif playback as "offscreen". Driving the transform
          // from rAF keeps the visibility bookkeeping fresh every frame.
          const GAP = 4;
          const DURATION = 35; // seconds per loop, same speed as the CSS animation
          let x = 0;
          let width = 0;
          let last = 0;
          let raf = 0;

          // offsetWidth is layout width, unaffected by the mobile scale transform
          const measure = () => { width = inners[0].offsetWidth + GAP; };

          const step = (now: number) => {
            // Clamp dt so returning from a background tab does not jump the bar
            const dt = Math.min((now - last) / 1000, 0.064);
            last = now;
            x = (x - (width / DURATION) * dt) % width;
            for (const inner of inners) inner.style.transform = `translate3d(${x}px, 0, 0)`;
            raf = requestAnimationFrame(step);
          };

          const start = () => {
            if (raf || reduced.matches || !marquee.classList.contains('is-ready')) return;
            marquee.classList.add('js-drive');
            measure();
            last = performance.now();
            raf = requestAnimationFrame(step);
          };

          const stop = () => {
            cancelAnimationFrame(raf);
            raf = 0;
            marquee.classList.remove('js-drive');
            for (const inner of inners) inner.style.transform = '';
          };

          window.addEventListener('resize', () => { if (raf) measure(); });
          reduced.addEventListener('change', () => reduced.matches ? stop() : start());

          // Fade the bar in once every stamp has loaded or failed, then start
          const imgs = marquee.querySelectorAll('img');
          let loaded = 0;
          const check = () => {
            if (++loaded >= imgs.length) {
              marquee.classList.add('is-ready');
              start();
            }
          };
          imgs.forEach(img => img.complete ? check() : (img.onload = img.onerror = check));
        }
      </script>
    </div>

    <div class="row main-row">
      <aside class="box panel panel-left"></aside>
      <main class="box panel panel-center">
        <div class="panel-content">
          <h2>Welcome to my website</h2>
          <p>You may be thinking to yourself, "Oliver, your website looks a little crazy." I know right! It's an homage to the early internet and GeoCities era of personal site dev and it has been a ton of fun to work on.</p>
          <p>If you don't know me, my name is Oliver Ohrt. I'm a CS student at UW-Madison though I was born and raised in Seattle. At Madison I helped run the Undergraduate Projects Lab, a student lab that's been around since the 1980s. I helped plan various events and Wisconsin's largest hackathon. Last summer I was at Amazon writing internal tools for the AGI org, this summer I'm doing the same. I graduate in December 2026.</p>
          <p>Most of my free time goes into hanging with friends and building things. Some recent ones: a  Tauri desktop app for mapping out social graphs in Neo4j, and a Go bot that watches company career pages so I don't have to. This site is the latest project. It's not done. It may never be done. That's kind of the point.</p>
          <p>Off the computer it's fishing, cooking, and listening to music (Recently Alice in Chains actually). Next semester I'm studying abroad in Thailand, so expect blog posts about that whenever the blog exists.</p>
          <p>Thanks for stopping by. Sign the guestbook on   your way out (there is no guestbook yet).</p>
        </div>
      </main>
      <aside class="box panel panel-right no-mobile"></aside>
    </div>
  </div>
</BaseLayout>

<style>
  .header {
    height: 288px;
    position: relative;
    width: 134.5%;
    left: -17.2%;
    overflow: visible;
    flex-shrink: 0;
    background: #3A7AB6 url('/images/header.png') center/cover no-repeat;
  }

  .logo-wrap {
    position: absolute;
    left: -90px;
    top: 5px;
    z-index: 999;
  }

  .logo-fallback {
    display: block;
  }

  .logo-composite {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .subheader {
    height: 30px;
    position: relative;
    width: 134.5%;
    left: -17.2%;
    flex-shrink: 0;
    background: linear-gradient(to bottom, #B2D1FF 0%, #80A7FF 50%, #3A7AB6 51%, #A8BEFF 100%);
  }

  .welcome-scroll {
    display: flex;
    overflow: hidden;
    height: 100%;
    align-items: center;
  }

  .welcome-scroll span {
    display: inline-block;
    white-space: nowrap;
    padding-left: 100%;
    animation: welcome-scroll 12s linear infinite;
    color: rgb(0, 46, 255);
    text-shadow: 0 0 6px #ffffff, 0 0 10px #ffffff;
    font-weight: bold;
    font-size: 14px;
  }

  @keyframes welcome-scroll {
    from { transform: translateX(-100%); }
    to   { transform: translateX(100%); }
  }

  /* Stamp marquee bar */
  .stamps {
    height: 60px;
    background: linear-gradient(to bottom, #FFF8B2 0%, #FFFB80 50%, #C2B41A 51%, #FFFFA8 100%);
  }

  .marquee {
    contain: layout paint;
    display: flex;
    /* The keyframe travels -100% - 4px, so the two strips need the same 4px
       gap between them that the stamps have inside each strip. Without this
       the bar pops 4px sideways every time the loop wraps. */
    gap: 4px;
    overflow: hidden;
    height: 100%;
  }

  .marquee__inner {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4px;
    min-width: 100%;
    will-change: transform;
    animation: stamp-scroll 35s linear infinite;
    animation-play-state: paused;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .marquee.is-ready .marquee__inner {
    animation-play-state: running;
    opacity: 1;
  }

  /* When the script drives the transform, the CSS animation has to get out
     of the way. The animation still serves as the no-js fallback. */
  .marquee.js-drive .marquee__inner {
    animation: none;
  }

  .marquee__inner img {
    flex-shrink: 0;
    height: 52px;
    width: auto;
  }

  @keyframes stamp-scroll {
    to { transform: translateX(calc(-100% - 4px)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__inner {
      animation-play-state: paused !important;
      opacity: 1 !important;
    }
    .welcome-scroll span {
      animation-play-state: paused !important;
    }
  }

  /* Row of three panels below the stamp bar.*/
  .main-row {
    display: flex;
    gap: var(--gap);
    position: relative;
    width: 140%;
    left: -20%;
    min-height: 620px;
    flex-shrink: 0;
  }

  .panel-left   { flex: 0 0 17%; }
  .panel-center { flex: 1 1 auto; display: flex; flex-direction: column; padding: 30px; }
  .panel-right  { flex: 0 0 20%; }

  .panel-content {
    flex: 1 1 0;
    min-height: 0;
    overflow-y: auto;
    background: #3F6589;
    color: #fff;
    padding: 20px;
    font-size: 17px;
    line-height: 1.55;
  }

  .panel-content p + p {
    margin-top: 14px;
  }

  .panel-content h2 {
    font-size: 24px;
    letter-spacing: 1px;
    margin-bottom: 14px;
  }

  /* Gradient*/
  .panel {
    background: linear-gradient(
      to bottom,
      rgba(101, 146, 190, 0.95) 0%,
      rgba(84, 130, 174, 0.95) 100%
    );
  }

  /* ── Mobile overrides ─────────────────────────────────────────────────────
     The whole layout is scaled down via transform in BaseLayout.
     These values are in the *unscaled* coordinate space, the browser scales
     them along with everything else.

     Logo: left: -90px sits at -255px in layout coords (header is at -165px).
     Setting left: 110px brings the logo onto screen after scaling.

     Heights doubled so they appear the same relative size after scaling.
  ───────────────────────────────────────────────────────────────────────── */
  @media (max-width: 1020px) {
    .header,
    .subheader {
      width: 100%;
      left: 0;
    }

    /* Right panel is hidden via .no-mobile, so center auto-fills the freed
       space. Extend leftward (width: 110%, all offset on the left side) so
       the left panel pokes past the header on mobile. */
    .main-row {
      width: 102%;
      left: -2%;
      min-height: 150vh;
    }

    .panel-left {
      flex: 0 0 30%;
    }

    .logo-wrap {
      left: -55px;
    }

    .subheader:not(.stamps) {
      height: 60px;
    }

    .stamps {
      height: 120px;
    }

    .marquee {
      height: 120px;
    }

    .marquee__inner img {
      height: 104px;
    }

    .welcome-scroll span {
      font-size: 28px;
    }

    /* Counter the global scale so the about text renders at a constant
       real size on phones, same trick as the 404 card */
    .panel-content {
      font-size: calc(11px / var(--scale));
      padding: calc(12px / var(--scale));
    }

    .panel-content p + p {
      margin-top: calc(8px / var(--scale));
    }

    .panel-content h2 {
      font-size: calc(14px / var(--scale));
      letter-spacing: calc(1px / var(--scale));
      margin-bottom: calc(6px / var(--scale));
    }
  }
</style>
