---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Oliver's corner of the web.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/logo_fallback.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Browser chrome color: works on Android Chrome + iOS Safari 15+ for address bar -->
    <meta name="theme-color" content="#202E46" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="823" />
    <meta property="og:image:height" content="287" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- background.webp and header.png live in CSS, so without a preload the
         browser only discovers them after the stylesheet is parsed -->
    <link rel="preload" as="image" href="/images/background.webp" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/logo_fallback.png" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/header.png" />
    <link rel="preload" as="image" href="/images/static.png" />
    <link rel="preload" as="image" href="/images/gears_sheet.webp" />
    <script
      defer
      src="https://app.rybbit.io/api/script.js"
      data-site-id="6958f7ab97a7"
      is:inline
    ></script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --gap: 10px;
    --container-width: 960px;
    --border-inner: rgb(0, 15, 149);
    --border-outer: rgb(96, 96, 96);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 20px;
    background-color: #202E46;
    font-family: "MS UI Gothic", "MS PGothic", sans-serif;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("/images/background.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1.0;
    z-index: -1;
  }

  .layout {
    width: var(--container-width);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
    --scale: 1;
    transform: scale(var(--scale));
    transform-origin: top center;
    /* The transform does not shrink layout height, so pull the page bottom
       up by the height the scale removed. Same trick the mobile ladder used. */
    margin-bottom: calc((var(--scale) - 1) * 100%);
  }

  .box {
    box-shadow:
      0 0 0 1.5px var(--border-inner),
      0 0 0 3px var(--border-outer);
    background: white;
  }

  /* Utility: add `no-mobile` to any element to hide it once the layout hits
     its first scale-down breakpoint. Will be used for arm lol */
  @media (max-width: 1020px) {
    .no-mobile { display: none !important; }
  }

  /* ── Desktop scaling ─────────────────────────────────────────────────────
     The design is sized for a 1920px wide screen where 960px fills half the
     viewport. Smaller or high-dpi laptops (a 14in retina MacBook is only
     1512 css px wide) see far fewer css pixels, so the fixed 960px looks
     zoomed in. These steps keep the site near the same fraction of the
     screen it has at 1920. Steps of 0.05 instead of a continuous formula
     because css cannot divide two lengths into a number in Firefox.
     Floor of 0.75 so text stays readable on tablets and small windows. */
  @media (max-width: 1919px) { .layout { --scale: 0.95; } }
  @media (max-width: 1750px) { .layout { --scale: 0.9;  } }
  @media (max-width: 1650px) { .layout { --scale: 0.85; } }
  @media (max-width: 1550px) { .layout { --scale: 0.8;  } }
  @media (max-width: 1450px) { .layout { --scale: 0.75; } }

  /* ── Mobile scaling ──────────────────────────────────────────────────────
     The site is fixed-width (960px). Rather than rebuilding the layout,
     we scale the whole thing down like zooming out. Each step only sets
     --scale; the transform and margin compensation live on .layout above.
  ───────────────────────────────────────────────────────────────────────── */
  @media (max-width: 1020px) { .layout { --scale: 0.9; } }
  @media (max-width: 900px)  { .layout { --scale: 0.78; } }
  @media (max-width: 780px)  { .layout { --scale: 0.67; } }
  @media (max-width: 650px)  { .layout { --scale: 0.56; } }
  @media (max-width: 540px)  { .layout { --scale: 0.46; } }
  @media (max-width: 430px)  { .layout { --scale: 0.37; } }
  @media (max-width: 360px)  { .layout { --scale: 0.31; } }
</style>