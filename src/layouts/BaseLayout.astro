---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Oliver's corner of the web.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/images/logo_fallback.png", Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Browser chrome color: works on Android Chrome + iOS Safari 15+ for address bar -->
    <meta name="theme-color" content="#202E46" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="823" />
    <meta property="og:image:height" content="287" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="/images/logo_fallback.png" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/static.png" />
    <link rel="preload" as="image" href="/images/gears.webp" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --gap: 10px;
    --container-width: 960px;
    --border-inner: rgb(0, 15, 149);
    --border-outer: rgb(96, 96, 96);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    width: 100%;
    height: 100%;
    overflow-x: hidden;
    overflow-x: clip;
  }

  body {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 20px;
    background-color: #202E46;
    font-family: "MS UI Gothic", "MS PGothic", sans-serif;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("/images/background.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 1.0;
    z-index: -1;
  }

  .layout {
    width: var(--container-width);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  .box {
    box-shadow:
      0 0 0 1.5px var(--border-inner),
      0 0 0 3px var(--border-outer);
    background: white;
  }

  /* Utility: add `no-mobile` to any element to hide it once the layout hits
     its first scale-down breakpoint. Will be used for arm lol */
  @media (max-width: 1020px) {
    .no-mobile { display: none !important; }
  }

  /* ── Mobile scaling ──────────────────────────────────────────────────────
     The site is fixed-width (960px). Rather than rebuilding the layout,
     we scale the whole thing down like zooming out
  ───────────────────────────────────────────────────────────────────────── */
  @media (max-width: 1020px) {
    .layout {
      transform: scale(0.9);
      transform-origin: top center;
      margin-bottom: -10%;
    }
  }

  @media (max-width: 900px) {
    .layout {
      transform: scale(0.78);
      transform-origin: top center;
      margin-bottom: -22%;
    }
  }

  @media (max-width: 780px) {
    .layout {
      transform: scale(0.67);
      transform-origin: top center;
      margin-bottom: -33%;
    }
  }

  @media (max-width: 650px) {
    .layout {
      transform: scale(0.56);
      transform-origin: top center;
      margin-bottom: -44%;
    }
  }

  @media (max-width: 540px) {
    .layout {
      transform: scale(0.46);
      transform-origin: top center;
      margin-bottom: -54%;
    }
  }

  @media (max-width: 430px) {
    .layout {
      transform: scale(0.37);
      transform-origin: top center;
      margin-bottom: -63%;
    }
  }

  @media (max-width: 360px) {
    .layout {
      transform: scale(0.31);
      transform-origin: top center;
      margin-bottom: -69%;
    }
  }
</style>